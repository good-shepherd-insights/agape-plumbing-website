{
  "rewrites": [
    {
      "source": "/services/:location/:serviceSlug",
      "destination": "/index.html"
    },
    {
      "source": "/areas/:location/:serviceSlug",
      "destination": "/index.html"
    },
    {
      "source": "/areas/:location",
      "destination": "/index.html"
    },
    {
      "source": "/services/:serviceSlug",
      "destination": "/index.html"
    },
    {
      "source": "/areas",
      "destination": "/index.html"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
