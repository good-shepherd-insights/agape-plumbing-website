      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you provide 24/7 emergency plumbing services?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we provide 24/7 emergency plumbing services throughout our service area. Call (227) 223-9057 for immediate assistance with burst pipes, water heater failures, sewer backups, and other urgent plumbing issues."
          }
        },
        {
          "@type": "Question",
          "name": "What areas do you serve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We serve residential and commercial customers throughout our service area, providing comprehensive plumbing services for all types of properties."
          }
        },
        {
          "@type": "Question",
          "name": "Are you licensed and insured?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Agape Drain & Plumbing LLC is fully licensed and insured. We are also certified backflow prevention technicians, ensuring all work meets professional standards and regulations."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer free estimates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we provide free estimates on all plumbing services. Contact us at (227) 223-9057 to schedule your free estimate and consultation."
          }
        },
        {
          "@type": "Question",
          "name": "What types of plumbing services do you provide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide comprehensive plumbing services including emergency repairs, drain cleaning, water heater installation and repair, pipe repair and replacement, toilet services, faucet and fixture installation, kitchen plumbing, sewer line services, leak detection, hydro jetting, and commercial plumbing services."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly can you respond to emergency calls?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We provide fast emergency response and aim to arrive quickly to minimize damage and restore your plumbing system. Our emergency service is available 24/7, including weekends and holidays."
          }
        },
        {
          "@type": "Question",
          "name": "Do you work on both residential and commercial properties?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we provide plumbing services for both residential and commercial properties, including restaurants, office buildings, multi-family properties, and code compliance updates."
          }
        }
